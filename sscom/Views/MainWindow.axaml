<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SscomAvalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SscomAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="794" Height="600"
        MinWidth="720" MinHeight="520"
        Title="sscom-avalonia — 串口数据调试器"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource StBgBrush}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="串口窗口">
        <MenuItem Header="刷新端口" Command="{Binding RefreshPortsCommand}" />
        <MenuItem Header="退出" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="串口设置">
        <MenuItem Header="更多串口设置" Command="{Binding ToggleMoreSerialCommand}" />
      </MenuItem>
      <MenuItem Header="显示" />
      <MenuItem Header="发送" />
      <MenuItem Header="多字符串">
        <MenuItem Header="扩展/隐藏" Command="{Binding ToggleExtensionCommand}" />
      </MenuItem>
      <MenuItem Header="小工具" />
      <MenuItem Header="帮助">
        <MenuItem Header="关于" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource StToolbarBrush}"
            Padding="8,3" BorderThickness="0,1,0,0"
            BorderBrush="{StaticResource StBorderBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusLeft}" VerticalAlignment="Center" Classes="muted" />
        <TextBlock Grid.Column="1" Text="{Binding StatusCounts}" Margin="12,0"
                   VerticalAlignment="Center" Classes="muted" />
        <TextBlock Grid.Column="2" Text="{Binding StatusInfo}" VerticalAlignment="Center"
                   Classes="muted" />
      </Grid>
    </Border>

    <!-- receive * | toolbar Auto | lower fixed -->
    <Grid RowDefinitions="*,Auto,176" Margin="6,4,6,4">

      <!-- Receive + Extension -->
      <Grid Grid.Row="0" Name="RecvGrid" ColumnDefinitions="*,0,0" ClipToBounds="True">
        <Border Classes="card" ClipToBounds="True">
          <TextBox Name="ReceiveBox"
                   Classes="mono"
                   Text="{Binding ReceiveText}"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   BorderThickness="0"
                   VerticalContentAlignment="Top"
                   MinHeight="80"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <GridSplitter Grid.Column="1" Width="4"
                      IsVisible="{Binding ExtensionVisible}"
                      ResizeDirection="Columns"
                      Background="{StaticResource StBorderBrush}" />

        <Border Grid.Column="2"
                IsVisible="{Binding ExtensionVisible}"
                Classes="card" Padding="4,4,2,2"
                Margin="2,0,0,0" ClipToBounds="True">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="多字符串" Classes="section"
                       Margin="0,0,0,4" HorizontalAlignment="Left" />
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,2,0">
              <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PresetItemViewModel">
                    <Grid ColumnDefinitions="22,*,Auto,Auto" Margin="0,1"
                          MinHeight="28" ClipToBounds="True">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                 Classes="muted" HorizontalAlignment="Center"
                                 TextAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding Text}"
                               Classes="row-edit"
                               VerticalAlignment="Center" />
                      <CheckBox Grid.Column="2" Content="HEX" IsChecked="{Binding Hex}"
                                Margin="6,0,4,0" Classes="compact"
                                VerticalAlignment="Center" />
                      <Button Grid.Column="3" Content="发送" Command="{Binding SendCommand}"
                              Classes="accent compact-btn"
                              MinWidth="44" Margin="0,0,2,0"
                              VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Toolbar: uniform 26px controls -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            Margin="0,4,0,4" MinHeight="28">
        <Button Grid.Column="0" Content="清除窗口" Command="{Binding ClearReceiveCommand}"
                Classes="danger compact-btn" Margin="0,0,4,0" />
        <Button Grid.Column="1" Content="打开文件" Command="{Binding OpenFileToSendCommand}"
                Classes="compact-btn" Margin="0,0,4,0" />
        <Button Grid.Column="3" Content="发送文件" Command="{Binding SendFileCommand}"
                Classes="compact-btn" Margin="0,0,4,0" />
        <Button Grid.Column="4" Content="停止" Command="{Binding StopCommand}"
                Classes="danger compact-btn" Margin="0,0,4,0" />
        <Button Grid.Column="5" Content="清发送区" Command="{Binding ClearSendCommand}"
                Classes="compact-btn" Margin="0,0,10,0" />
        <CheckBox Grid.Column="6" Content="最前" IsChecked="{Binding StayOnTop}"
                  Classes="compact" Margin="0,0,10,0" />
        <CheckBox Grid.Column="7" Content="English" IsChecked="{Binding EnglishLabels}"
                  Classes="compact" Margin="0,0,10,0" />
        <CheckBox Grid.Column="8" Content="保存参数" IsChecked="{Binding SaveParamsOnExit}"
                  Classes="ok compact" Margin="0,0,10,0" />
        <Button Grid.Column="9" Content="{Binding ExtButtonLabel}"
                Command="{Binding ToggleExtensionCommand}"
                Classes="ok compact-btn" FontWeight="SemiBold" />
      </Grid>

      <!-- Lower: left serial | right options+send -->
      <Grid Grid.Row="2" ColumnDefinitions="236,*" ClipToBounds="True">

        <!-- Left serial column: fixed label width 52 + * controls -->
        <Grid Grid.Column="0" Margin="0,0,8,0" ClipToBounds="True"
              RowDefinitions="Auto,Auto,Auto,Auto,*"
              RowSpacing="4">

          <!-- 端口号 -->
          <Grid Grid.Row="0" ColumnDefinitions="56,*" MinHeight="28">
            <TextBlock Text="端口号" Classes="label" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}"
                      SelectedItem="{Binding SelectedPort}" />
          </Grid>

          <!-- 打开串口 + refresh -->
          <Grid Grid.Row="1" ColumnDefinitions="14,*,26" ColumnSpacing="4" MinHeight="28">
            <Panel Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="{StaticResource StRedBrush}" IsVisible="{Binding !IsConnected}" />
              <Ellipse Width="10" Height="10" Fill="{StaticResource StOkBrush}" IsVisible="{Binding IsConnected}" />
            </Panel>
            <Button Grid.Column="1" Content="{Binding OpenCloseLabel}"
                    Command="{Binding ToggleConnectCommand}"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    Height="26" MinHeight="26" MaxHeight="26" Padding="10,2" />
            <Button Grid.Column="2" Content="↻" Command="{Binding RefreshPortsCommand}"
                    Classes="tool"
                    ToolTip.Tip="刷新端口" FontSize="13" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MinHeight="28">
            <Button Content="更多串口设置" Command="{Binding ToggleMoreSerialCommand}"
                    HorizontalAlignment="Stretch"
                    Height="26" MinHeight="26" MaxHeight="26" Padding="10,2" FontSize="12" />
            <CheckBox Grid.Column="1" Content="RTS" IsChecked="{Binding Rts}" Classes="compact" />
            <CheckBox Grid.Column="2" Content="DTR" IsChecked="{Binding Dtr}" Classes="compact" />
          </Grid>

          <!-- 波特率 — same 52|* grid as 端口号 -->
          <Grid Grid.Row="3" ColumnDefinitions="56,*" MinHeight="28">
            <TextBlock Text="波特率" Classes="label" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding BaudRates}"
                      SelectedItem="{Binding SelectedBaud}" />
          </Grid>

          <!-- More-serial + Send -->
          <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="0,2,0,0">
            <Border IsVisible="{Binding MoreSerialVisible}"
                    Classes="card" Padding="6,4" Margin="0,0,0,4">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnDefinitions="56,*"
                    RowSpacing="4">
                <TextBlock Text="数据位" Classes="label" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DataBitsOptions}"
                          SelectedItem="{Binding SelectedDataBits}" />
                <TextBlock Grid.Row="1" Text="停止位" Classes="label" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}"
                          SelectedItem="{Binding SelectedStopBits}" />
                <TextBlock Grid.Row="2" Text="校验" Classes="label" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ParityOptions}"
                          SelectedItem="{Binding SelectedParity}" />
                <TextBlock Grid.Row="3" Text="流控" Classes="label" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FlowOptions}"
                          SelectedItem="{Binding SelectedFlow}" />
              </Grid>
            </Border>
            <Button Grid.Row="1" Content="{Binding SendButtonLabel}" Command="{Binding SendCommand}"
                    Classes="accent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                    FontSize="15" FontWeight="Bold" MinHeight="40" />
          </Grid>
        </Grid>

        <!-- Right: options + timestamp + send -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" ClipToBounds="True"
              RowSpacing="4">

          <!-- Option row 1 -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" MinHeight="28"
                      VerticalAlignment="Center">
            <CheckBox Content="HEX显示" IsChecked="{Binding HexDisplay}" Classes="compact" />
            <CheckBox Content="保存数据" IsChecked="{Binding SaveData}" Classes="ok compact" />
            <CheckBox Content="接收数据到文件" IsChecked="{Binding RecvToFile}" Classes="compact" />
            <CheckBox Content="HEX发送" IsChecked="{Binding HexSend}" Classes="compact" />
          </StackPanel>

          <!-- Option row 2 -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" MinHeight="28"
                      VerticalAlignment="Center">
            <CheckBox Content="定时发送" IsChecked="{Binding AutoSend}" Classes="compact" />
            <NumericUpDown Value="{Binding AutoSendIntervalMs}"
                           Minimum="10" Maximum="600000" Width="68" FormatString="0"
                           Classes="compact-nud" />
            <TextBlock Text="ms/次" Classes="label"
                       HorizontalAlignment="Left" TextAlignment="Left" Margin="2,0,0,0" />
            <CheckBox Content="加回车换行" IsChecked="{Binding AppendNewline}" Classes="compact"
                      Margin="10,0,0,0" />
          </StackPanel>

          <!-- Timestamp / checksum row -->
          <Border Grid.Row="2" Classes="timestamp-row" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                        MinHeight="26">
              <CheckBox Content="加时间戳和分包显示" IsChecked="{Binding ShowTimestamp}"
                        Classes="compact" />
              <TextBlock Text="超时" Classes="label" Margin="6,0,0,0"
                         HorizontalAlignment="Left" TextAlignment="Left" />
              <NumericUpDown Value="{Binding PacketTimeoutMs}"
                             Minimum="1" Maximum="5000" Width="44" FormatString="0"
                             Classes="compact-nud" />
              <TextBlock Text="ms" Classes="label"
                         HorizontalAlignment="Left" TextAlignment="Left" Margin="0,0,0,0" />
              <TextBlock Text="第" Classes="label" Margin="8,0,0,0"
                         HorizontalAlignment="Left" TextAlignment="Left" />
              <NumericUpDown Value="{Binding CsFrom}"
                             Minimum="1" Maximum="9999" Width="40" FormatString="0"
                             Classes="compact-nud" />
              <TextBlock Text="字节至末尾" Classes="label"
                         HorizontalAlignment="Left" TextAlignment="Left" />
              <TextBlock Text="加校验" Classes="label" Margin="8,0,0,0"
                         HorizontalAlignment="Left" TextAlignment="Left" />
              <ComboBox ItemsSource="{Binding ChecksumOptions}"
                        SelectedItem="{Binding SelectedChecksum}"
                        Width="80" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <!-- Send edit -->
          <Border Grid.Row="3" Classes="card" ClipToBounds="True">
            <TextBox Classes="mono"
                     Text="{Binding SendText}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     PlaceholderText="发送内容…"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
