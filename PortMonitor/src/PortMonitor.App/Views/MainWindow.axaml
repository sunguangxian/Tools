<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PortMonitor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="820"
        x:Class="PortMonitor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PortMonitor — 多串口桥接 / Modbus / USB SCSI"
        Width="1360" Height="820"
        MinWidth="1000" MinHeight="560"
        Background="{StaticResource StBgBrush}">

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top" Background="{StaticResource StToolbarBrush}" Padding="4,2">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="保存会话…" Command="{Binding SaveSessionCommand}"/>
        <MenuItem Header="加载会话…" Command="{Binding LoadSessionCommand}"/>
        <Separator/>
        <MenuItem Header="导出 CSV" Command="{Binding ExportCsvCommand}"/>
        <MenuItem Header="导出 TXT" Command="{Binding ExportTxtCommand}"/>
        <MenuItem Header="导出 HTML" Command="{Binding ExportHtmlCommand}"/>
        <Separator/>
        <MenuItem Header="退出" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="编辑(_E)">
        <MenuItem Header="复制选中行" Command="{Binding CopySelectedCommand}"/>
        <MenuItem Header="清空日志" Command="{Binding ClearLogCommand}"/>
      </MenuItem>
      <MenuItem Header="监控(_M)">
        <MenuItem Header="全部打开" Command="{Binding OpenAllCommand}"/>
        <MenuItem Header="全部关闭" Command="{Binding CloseAllCommand}"/>
        <MenuItem Header="暂停/继续" Command="{Binding TogglePauseCommand}"/>
        <Separator/>
        <MenuItem Header="注入监控…（占位）" Command="{Binding ShowInjectStubCommand}"/>
        <MenuItem Header="按端口注入…（占位）" Command="{Binding ShowInjectByPortStubCommand}"/>
      </MenuItem>
      <MenuItem Header="视图(_V)">
        <MenuItem Header="自动滚动" ToggleType="CheckBox" IsChecked="{Binding AutoScroll}"/>
        <MenuItem Header="显示 CRC 错误" ToggleType="CheckBox" IsChecked="{Binding ShowCrcErrors}"/>
        <MenuItem Header="转义控制字符" ToggleType="CheckBox" IsChecked="{Binding EscapeControls}"/>
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于 PortMonitor" Command="{Binding AboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Icon toolbar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource StToolbarBrush}"
            BorderBrush="{StaticResource StBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="tool" Content="＋会话" Command="{Binding FocusNewSessionCommand}" ToolTip.Tip="添加会话"/>
        <Button Classes="tool" Content="▶ 打开" Command="{Binding OpenSelectedCommand}" ToolTip.Tip="打开选中会话"/>
        <Button Classes="tool" Content="■ 关闭" Command="{Binding CloseSelectedCommand}"/>
        <Button Classes="tool" Content="全部▶" Command="{Binding OpenAllCommand}"/>
        <Button Classes="tool" Content="全部■" Command="{Binding CloseAllCommand}"/>
        <Border Width="1" Background="{StaticResource StBorderBrush}" Margin="4,2"/>
        <Button Classes="tool" Content="⏸ 暂停" Command="{Binding TogglePauseCommand}"/>
        <Button Classes="tool" Content="清空" Command="{Binding ClearLogCommand}"/>
        <Button Classes="tool" Content="导出" Command="{Binding ExportCsvCommand}"/>
        <Button Classes="tool" Content="保存" Command="{Binding SaveSessionCommand}"/>
        <Border Width="1" Background="{StaticResource StBorderBrush}" Margin="4,2"/>
        <Button Classes="tool" Content="注入" Command="{Binding ShowInjectStubCommand}" ToolTip.Tip="进程注入（.NET 占位，完整实现见 Hook DLL）"/>
        <Button Classes="tool" Content="USB" Command="{Binding GotoUsbTabCommand}"/>
        <Button Classes="tool" Content="发送" Command="{Binding FocusSendCommand}"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource StToolbarBrush}" Padding="10,4"
            BorderBrush="{StaticResource StBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource StTextBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"/>
        <TextBlock Grid.Column="1" Text="{Binding StatsText}" Foreground="{StaticResource StMutedBrush}"
                   Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"/>
      </Grid>
    </Border>

    <!-- Left: session tree + new session -->
    <Border DockPanel.Dock="Left" Width="300" Background="{StaticResource StSidebarBrush}"
            BorderBrush="{StaticResource StBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="会话 / 端口" Classes="section" Margin="10,8,10,4"/>

        <Border DockPanel.Dock="Bottom" Classes="card" Margin="6,4" Padding="6">
          <StackPanel Spacing="3">
            <TextBlock Text="新建会话" Classes="section" Margin="0,0,0,0"/>
            <Grid ColumnDefinitions="40,*,40,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2" ColumnSpacing="4">
              <TextBlock Classes="label" Text="名称" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding NewName}" PlaceholderText="可选" MinHeight="26"/>
              <TextBlock Grid.Column="2" Classes="label" Text="模式" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding NewModeChoice}"/>
              <TextBlock Grid.Row="1" Classes="label" Text="端口A" VerticalAlignment="Center"/>
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <ComboBox IsEditable="True" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AvailablePorts}" Text="{Binding NewPortA}"/>
                <Button Grid.Column="1" Content="⟳" Classes="tool" Command="{Binding RefreshPortsCommand}"/>
              </Grid>
              <TextBlock Grid.Row="2" Classes="label" Text="端口B" VerticalAlignment="Center"
                         IsVisible="{Binding NewIsBridge}"/>
              <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" IsEditable="True"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AvailablePorts}" Text="{Binding NewPortB}"
                        IsVisible="{Binding NewIsBridge}"/>
              <TextBlock Grid.Row="3" Classes="label" Text="波特" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding BaudRates}" SelectedItem="{Binding NewBaudRate}"/>
              <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2"
                          VerticalAlignment="Center">
                <ComboBox Width="44" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding NewDataBits}"/>
                <ComboBox Width="56" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding NewParity}"/>
                <ComboBox MinWidth="56" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding NewStopBits}"/>
              </StackPanel>
              <Button Grid.Row="4" Grid.ColumnSpan="4" Classes="accent" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Content="＋ 添加会话" Command="{Binding AddSessionCommand}"
                      Padding="8,3" MinHeight="28"/>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,0,8,6">
          <Button Content="全部打开" Command="{Binding OpenAllCommand}" Padding="8,3"/>
          <Button Content="全部关闭" Command="{Binding CloseAllCommand}" Padding="8,3"/>
        </StackPanel>

        <TreeView Margin="4,0" ItemsSource="{Binding TreeRoots}" SelectedItem="{Binding SelectedTreeNode}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:TreeNode">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                  <Ellipse.Fill>
                    <SolidColorBrush Color="{Binding DotColor}"/>
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding Title}" FontSize="12"/>
                <TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="4,0,0,0"/>
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>

    <!-- Filter bar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource StPanelBrush}" Padding="8,5"
            BorderBrush="{StaticResource StBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <WrapPanel ItemSpacing="6" LineSpacing="4">
          <TextBlock Classes="label" Text="会话"/>
          <ComboBox Width="160" ItemsSource="{Binding SessionFilters}" SelectedItem="{Binding SelectedSessionFilter}"/>
          <TextBlock Classes="label" Text="方向"/>
          <ComboBox Width="90" ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding SelectedDirection}"/>
          <TextBlock Classes="label" Text="进制"/>
          <ComboBox Width="70" ItemsSource="{Binding RadixChoices}" SelectedItem="{Binding SelectedRadix}"/>
          <TextBlock Classes="label" Text="编码"/>
          <ComboBox Width="90" ItemsSource="{Binding EncodingChoices}" SelectedItem="{Binding SelectedEncoding}"/>
          <TextBlock Classes="label" Text="Modbus"/>
          <ComboBox Width="90" ItemsSource="{Binding ModbusModeChoices}" SelectedItem="{Binding SelectedModbusMode}"/>
          <TextBox Width="160" Text="{Binding SearchText}" PlaceholderText="搜索 HEX / 文本"/>
          <CheckBox Content="转义控制符" IsChecked="{Binding EscapeControls}"/>
          <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll}"/>
          <CheckBox Content="CRC 错误" IsChecked="{Binding ShowCrcErrors}"/>
          <CheckBox Content="自动保存" IsChecked="{Binding AutosaveEnabled}"/>
        </WrapPanel>
        <TextBlock Text="{Binding LastError}" Foreground="{StaticResource StRedBrush}" TextWrapping="Wrap" FontSize="11"
                   IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </Border>

    <!-- Bottom: detail / send / stats -->
    <Border DockPanel.Dock="Bottom" Height="168" Background="{StaticResource StPanelBrush}"
            BorderBrush="{StaticResource StBorderBrush}" BorderThickness="0,1,0,0">
      <TabControl Padding="0" x:Name="BottomTabs">
        <TabItem Header="数据详情">
          <Grid ColumnDefinitions="*,220" Margin="8">
            <Grid RowDefinitions="Auto,*" Margin="0,0,8,0">
              <TextBlock Classes="muted" Text="HEX / 文本"/>
              <TextBox Grid.Row="1" Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       Text="{Binding DetailHex}" Background="{StaticResource StBgBrush}"/>
            </Grid>
            <Border Grid.Column="1" Classes="card" Padding="8">
              <StackPanel Spacing="3">
                <TextBlock Classes="muted" Text="{Binding DetailMeta}"/>
                <TextBlock Classes="mono" Text="{Binding DetailAscii}" TextWrapping="Wrap" Foreground="{StaticResource StGreenBrush}"/>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="发送" x:Name="SendTab">
          <Grid ColumnDefinitions="*,Auto" Margin="8" ColumnSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="向选中会话注入（HEX 空格分隔，或勾选文本）"/>
              <TextBox Classes="mono" AcceptsReturn="True" Height="70" Text="{Binding SendPayload}"
                       PlaceholderText="01 03 00 00 00 01"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="按文本发送" IsChecked="{Binding SendAsText}"/>
                <CheckBox Content="追加 CRC16" IsChecked="{Binding SendAppendCrc}"/>
                <CheckBox Content="追加 CR LF" IsChecked="{Binding SendAppendCrLf}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
              <Button Classes="accent" Content="发送" Command="{Binding SendCommand}" Width="88"/>
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="统计">
          <TextBlock Margin="12" Classes="mono" Text="{Binding StatsDetail}" TextWrapping="Wrap"/>
        </TabItem>
        <TabItem Header="端口事件">
          <ListBox ItemsSource="{Binding PortEvents}" FontFamily="Consolas, monospace" FontSize="11">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PortEventRow">
                <TextBlock Text="{Binding Display}" Foreground="{StaticResource StYellowBrush}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="注入（说明）">
          <TextBlock Margin="12" TextWrapping="Wrap" Text="{Binding InjectHelpText}" Classes="muted"/>
        </TabItem>
      </TabControl>
    </Border>

    <!-- Main tabs -->
    <TabControl x:Name="MainTabs" Margin="6" Padding="0">
      <TabItem Header="列表">
        <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
          <Grid ColumnDefinitions="48,88,72,48,*,40,*,*" Margin="4,0,4,2">
            <TextBlock Classes="head" Text="#"/>
            <TextBlock Grid.Column="1" Classes="head" Text="时间"/>
            <TextBlock Grid.Column="2" Classes="head" Text="会话"/>
            <TextBlock Grid.Column="3" Classes="head" Text="方向"/>
            <TextBlock Grid.Column="4" Classes="head" Text="端口"/>
            <TextBlock Grid.Column="5" Classes="head" Text="长度"/>
            <TextBlock Grid.Column="6" Classes="head" Text="数据"/>
            <TextBlock Grid.Column="7" Classes="head" Text="文本"/>
          </Grid>
          <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}"
                   SelectedItem="{Binding SelectedLog}"
                   FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                   BorderBrush="{StaticResource StBorderBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogEntryViewModel">
                <Grid ColumnDefinitions="48,88,72,48,*,40,*,*" Margin="0,0">
                  <TextBlock Text="{Binding Sequence}" Foreground="{StaticResource StMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{StaticResource StBlueBrush}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Session}" Foreground="{StaticResource StPurpleBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3" Text="{Binding Direction}" Foreground="{StaticResource StYellowBrush}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="4" Text="{Binding Ports}" Foreground="{StaticResource StMutedBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="5" Text="{Binding Length}" Foreground="{StaticResource StMutedBrush}"/>
                  <TextBlock Grid.Column="6" Text="{Binding DisplayData}" Foreground="{StaticResource StOrangeBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="7" Text="{Binding DisplayText}" Foreground="{StaticResource StGreenBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="行视图">
        <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
          <Grid ColumnDefinitions="48,88,72,48,40,*,*" Margin="4,0,4,2">
            <TextBlock Classes="head" Text="#"/>
            <TextBlock Grid.Column="1" Classes="head" Text="时间"/>
            <TextBlock Grid.Column="2" Classes="head" Text="会话"/>
            <TextBlock Grid.Column="3" Classes="head" Text="方向"/>
            <TextBlock Grid.Column="4" Classes="head" Text="长度"/>
            <TextBlock Grid.Column="5" Classes="head" Text="HEX"/>
            <TextBlock Grid.Column="6" Classes="head" Text="文本"/>
          </Grid>
          <ListBox Grid.Row="1" x:Name="LineList" ItemsSource="{Binding LineEntries}"
                   FontFamily="Consolas, monospace" FontSize="12"
                   BorderBrush="{StaticResource StBorderBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LineRowViewModel">
                <Grid ColumnDefinitions="48,88,72,48,40,*,*" Margin="0,0">
                  <TextBlock Text="{Binding Sequence}" Foreground="{StaticResource StMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{StaticResource StBlueBrush}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Session}" Foreground="{StaticResource StPurpleBrush}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Direction}" Foreground="{StaticResource StYellowBrush}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="4" Text="{Binding Length}" Foreground="{StaticResource StMutedBrush}"/>
                  <TextBlock Grid.Column="5" Text="{Binding Hex}" Foreground="{StaticResource StOrangeBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="6" Text="{Binding Text}" Foreground="{StaticResource StGreenBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="终端">
        <TextBox x:Name="TerminalBox" Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 Text="{Binding TerminalText}" Margin="0,4,0,0"
                 Background="{StaticResource StBgBrush}" BorderBrush="{StaticResource StBorderBrush}"/>
      </TabItem>

      <TabItem Header="Modbus">
        <Grid RowDefinitions="Auto,*" Margin="0,4,0,0">
          <Grid ColumnDefinitions="44,80,64,44,40,70,44,56,*,*" Margin="4,0,4,2">
            <TextBlock Classes="head" Text="#"/>
            <TextBlock Grid.Column="1" Classes="head" Text="时间"/>
            <TextBlock Grid.Column="2" Classes="head" Text="会话"/>
            <TextBlock Grid.Column="3" Classes="head" Text="方向"/>
            <TextBlock Grid.Column="4" Classes="head" Text="从站"/>
            <TextBlock Grid.Column="5" Classes="head" Text="功能码"/>
            <TextBlock Grid.Column="6" Classes="head" Text="校验"/>
            <TextBlock Grid.Column="7" Classes="head" Text="协议"/>
            <TextBlock Grid.Column="8" Classes="head" Text="摘要"/>
            <TextBlock Grid.Column="9" Classes="head" Text="Hex"/>
          </Grid>
          <ListBox Grid.Row="1" x:Name="ModbusList" ItemsSource="{Binding ModbusFrames}"
                   FontFamily="Consolas, monospace" FontSize="12"
                   BorderBrush="{StaticResource StBorderBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModbusFrameViewModel">
                <Grid ColumnDefinitions="44,80,64,44,40,70,44,56,*,*">
                  <TextBlock Text="{Binding Sequence}" Foreground="{StaticResource StMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{StaticResource StBlueBrush}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Session}" Foreground="{StaticResource StPurpleBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3" Text="{Binding Direction}" Foreground="{StaticResource StYellowBrush}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="4" Text="{Binding Slave}"/>
                  <TextBlock Grid.Column="5" Text="{Binding Function}" Foreground="{StaticResource StPurpleBrush}"/>
                  <TextBlock Grid.Column="6" Text="{Binding Crc}" Foreground="{Binding CrcBrush}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="7" Text="{Binding Protocol}" Foreground="{StaticResource StBlueBrush}"/>
                  <TextBlock Grid.Column="8" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="9" Text="{Binding Hex}" Foreground="{StaticResource StMutedBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="USB / SCSI">
        <DockPanel Margin="0,4,0,0" DataContext="{Binding Usb}" x:DataType="vm:UsbMonitorViewModel">
          <Border DockPanel.Dock="Top" Classes="card" Padding="8" Margin="0,0,0,6">
            <StackPanel Spacing="4">
              <WrapPanel ItemSpacing="6" LineSpacing="4">
                <TextBlock Classes="label" Text="USBPcapCMD"/>
                <TextBox Width="260" Text="{Binding CmdPath}" IsEnabled="{Binding !IsCapturing}"/>
                <TextBlock Classes="label" Text="接口"/>
                <ComboBox Width="130" IsEditable="True" ItemsSource="{Binding Interfaces}"
                          Text="{Binding SelectedInterface}" IsEnabled="{Binding !IsCapturing}"/>
                <Button Content="⟳" Classes="tool" Command="{Binding RefreshInterfacesCommand}"/>
                <TextBlock Classes="label" Text="设备"/>
                <TextBox Width="56" Text="{Binding DeviceFilter}" PlaceholderText="全部" IsEnabled="{Binding !IsCapturing}"/>
                <Button Classes="accent" Content="▶ 抓包" Command="{Binding StartCommand}"/>
                <Button Content="■ 停止" Command="{Binding StopCommand}"/>
                <Button Content="打开 pcap…" Click="OnOpenPcapClick"/>
                <Button Content="导出 SCSI" Command="{Binding ExportScsiCsvCommand}"/>
                <Button Content="清空" Command="{Binding ClearCommand}"/>
                <CheckBox Content="仅 Bulk" IsChecked="{Binding OnlyMassStorage}"/>
                <TextBlock Classes="label" Text="{Binding Stats}" Margin="8,0,0,0"/>
              </WrapPanel>
              <TextBlock Text="{Binding Message}" Foreground="{StaticResource StYellowBrush}" TextWrapping="Wrap" FontSize="11"
                         IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="220,*">
            <Border Classes="card" Margin="0,0,6,0" Padding="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="设备树" Classes="section" Margin="4"/>
                <TreeView ItemsSource="{Binding DeviceTree}">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:UsbTreeNode">
                      <TextBlock Text="{Binding Title}" FontSize="11"/>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
            </Border>
            <TabControl Grid.Column="1" Padding="0">
              <TabItem Header="SCSI 命令">
                <ListBox ItemsSource="{Binding ScsiCommands}" FontFamily="Consolas, monospace" FontSize="11"
                         BorderBrush="{StaticResource StBorderBrush}" BorderThickness="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScsiRow">
                      <Grid ColumnDefinitions="36,100,44,44,150,80,70,70,*">
                        <TextBlock Text="{Binding Index}" Foreground="{StaticResource StMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource StBlueBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Device}" Foreground="{StaticResource StPurpleBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Tag}" Foreground="{StaticResource StMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Opcode}" Foreground="{StaticResource StYellowBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="{Binding Lba}"/>
                        <TextBlock Grid.Column="6" Text="{Binding Size}"/>
                        <TextBlock Grid.Column="7" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="8" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </TabItem>
              <TabItem Header="URB / 传输">
                <ListBox ItemsSource="{Binding Transfers}" FontFamily="Consolas, monospace" FontSize="11"
                         BorderBrush="{StaticResource StBorderBrush}" BorderThickness="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:UsbTransferRow">
                      <Grid ColumnDefinitions="44,100,70,80,44,44,70,*">
                        <TextBlock Text="{Binding Index}" Foreground="{StaticResource StMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource StBlueBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Address}" Foreground="{StaticResource StPurpleBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Direction}" Foreground="{StaticResource StYellowBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Type}"/>
                        <TextBlock Grid.Column="5" Text="{Binding Length}"/>
                        <TextBlock Grid.Column="6" Text="{Binding Status}" Foreground="{Binding StatusBrush}"/>
                        <TextBlock Grid.Column="7" Text="{Binding Hex}" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </TabItem>
            </TabControl>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
